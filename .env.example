# Where Odoo listens. Inside compose it is the service name, from the host it is
# http://localhost:8069
ODOO_URL=http://odoo:8069

# Database name. The compose file creates "odoo" on first start.
ODOO_DB=odoo

# Login for the XML-RPC calls. The demo instance ships with admin/admin, a real
# instance needs its own user with the right access rights.
ODOO_USER=admin
ODOO_PASSWORD=admin

# Which companies the answers come from, by numeric id. Empty means the one the
# login belongs to, which is the safe default: one company, no ambiguity.
#
# Several are allowed, separated by commas, and then every answer names the
# company it came from. In the demo database company 1 has the orders and the
# stock while company 3 is the Austrian one with invoices in euros, so
# ODOO_COMPANY_IDS=1,3 shows both sides at once.
ODOO_COMPANY_IDS=

# debug, info, warning or error. Logs are JSON and go to stderr.
LOG_LEVEL=info
