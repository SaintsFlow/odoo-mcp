# Where Odoo listens. Inside compose it is the service name, from the host it is
# http://localhost:8069
ODOO_URL=http://odoo:8069

# Database name. The compose file creates "odoo" on first start.
ODOO_DB=odoo

# Login for the XML-RPC calls. The demo instance ships with admin/admin, a real
# instance needs its own user with the right access rights.
ODOO_USER=admin
ODOO_PASSWORD=admin

# Numeric id of the company every answer comes from. Leave it empty and the
# server uses the company the login belongs to. Set it when one login can reach
# several companies and you want the answers to come from a particular one:
# the demo database carries three, and without a choice the same invoice number
# would come back twice in two currencies.
ODOO_COMPANY_ID=

# debug, info, warning or error. Logs are JSON and go to stderr.
LOG_LEVEL=info
