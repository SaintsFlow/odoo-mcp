# Where Odoo listens. Inside compose it is the service name, from the host it is
# http://localhost:8069
ODOO_URL=http://odoo:8069

# Database name. The compose file creates "odoo" on first start.
ODOO_DB=odoo

# Login for the XML-RPC calls. The demo instance ships with admin/admin, a real
# instance needs its own user with the right access rights.
ODOO_USER=admin
ODOO_PASSWORD=admin

# Which companies the answers come from, by numeric id. Empty means the one the
# login belongs to, which is the safe default: one company, no ambiguity.
#
# Several are allowed, separated by commas, and then every answer names the
# company it came from. In the demo database company 1 has the orders and the
# stock while company 3 is the Austrian one with invoices in euros, so
# ODOO_COMPANY_IDS=1,3 shows both sides at once.
ODOO_COMPANY_IDS=

# Set this to true when pointing the server at a database that matters. The two
# write tools are then never published at all, so a client cannot call them even
# by mistake: they are simply not on the list.
ODOO_READONLY=

# Seconds to wait for one Odoo call before giving up, 30 by default. Without a
# deadline of our own a stuck call waits as long as the operating system allows
# and the agent hears nothing back.
ODOO_TIMEOUT=30

# How the server talks to its client: stdio when it runs beside it (the usual
# case for a desktop client), or http when it runs somewhere else.
MCP_TRANSPORT=stdio

# Where the http transport listens. Loopback by default, because a server that
# opens itself to the network on first start is a surprise. In docker compose
# it is set to 0.0.0.0 and the port mapping decides who can reach it.
MCP_HOST=127.0.0.1
MCP_PORT=8080

# debug, info, warning or error. Logs are JSON and go to stderr.
LOG_LEVEL=info
